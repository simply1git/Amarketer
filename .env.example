# Amarketer Environment Configuration Template
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Preferred OpenRouter Model (default: deepseek/deepseek-r1:free or qwen/qwen-2.5-72b-instruct:free)
OPENROUTER_MODEL=deepseek/deepseek-r1:free

# Site Configuration
SITE_URL=https://amarketer.25012004.xyz
